{
  "$id": "https://unpkg.com/gherkin-ai/schemas/industry-context.schema.json",
  "title": "gherkin-ai industry context",
  "$ref": "#/definitions/IndustryContext",
  "definitions": {
    "IndustryContext": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "generic",
            "banking",
            "telecom",
            "manufacturing",
            "health",
            "supply-chain",
            "insurance",
            "aviation",
            "automotive"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "scope": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "name",
              "url",
              "scope"
            ],
            "additionalProperties": false
          }
        },
        "canonicalModel": {
          "type": "string",
          "minLength": 1
        },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term": {
                "type": "string",
                "minLength": 1
              },
              "avoid": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "term",
              "avoid",
              "definition"
            ],
            "additionalProperties": false
          }
        },
        "recommendedArchitectures": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "ddd",
              "hexagonal",
              "clean",
              "cqrs",
              "microservices",
              "monolith",
              "modular",
              "api-rest",
              "serverless",
              "event-driven",
              "monorepo-workspaces",
              "desktop"
            ]
          },
          "minItems": 1
        },
        "recommendedPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "compliance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tagNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "approvalPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "guidance": {
          "type": "object",
          "properties": {
            "compact": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 3
            }
          },
          "required": [
            "compact",
            "rules"
          ],
          "additionalProperties": false
        },
        "lintRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning",
                  "info"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "severity"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "label",
        "summary",
        "aliases",
        "standards",
        "canonicalModel",
        "glossary",
        "recommendedArchitectures",
        "recommendedPatterns",
        "compliance",
        "tagNamespaces",
        "approvalPaths",
        "guidance",
        "lintRules"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
