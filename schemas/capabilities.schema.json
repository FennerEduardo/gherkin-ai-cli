{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/gherkin-ai/schemas/capabilities.schema.json",
  "title": "gherkin-ai capability manifest (ghk expose)",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "gherkin-ai.dev/v1"
    },
    "kind": {
      "type": "string",
      "const": "CapabilityManifest"
    },
    "service": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "contract": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "baseUrlEnv": {
          "default": "GHK_UPSTREAM_URL",
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "properties": {
        "tenantClaim": {
          "default": "tenant_id",
          "type": "string",
          "minLength": 1
        },
        "scopesClaim": {
          "default": "scope",
          "type": "string",
          "minLength": 1
        },
        "rolesClaim": {
          "default": "roles",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "environments": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "allowWrites": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "version": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "type": "string",
            "enum": [
              "read",
              "analysis",
              "test-execution",
              "write",
              "destructive",
              "financial-critical"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "approved",
              "pending-specification"
            ]
          },
          "reason": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "properties": {
              "features": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "scenarios": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "handler": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^\\/[^\\s?#]*$"
              },
              "operationId": {
                "type": "string"
              },
              "parameters": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "in": {
                      "type": "string",
                      "enum": [
                        "path",
                        "query",
                        "header"
                      ]
                    },
                    "argument": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "in"
                  ],
                  "additionalProperties": false
                }
              },
              "body": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "method",
              "path"
            ],
            "additionalProperties": false
          },
          "input": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "output": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "examples": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "arguments": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "name",
                "arguments"
              ],
              "additionalProperties": false
            }
          },
          "authorization": {
            "type": "object",
            "properties": {
              "scopes": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "roles": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "tenancy": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "const": "identity"
              },
              "claim": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source",
              "claim"
            ],
            "additionalProperties": false
          },
          "execution": {
            "type": "object",
            "properties": {
              "approval": {
                "type": "string",
                "enum": [
                  "none",
                  "human"
                ]
              },
              "idempotency": {
                "type": "string",
                "enum": [
                  "required",
                  "none"
                ]
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 100,
                "maximum": 120000
              },
              "rateLimitPerMinute": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "approval",
              "idempotency",
              "timeoutMs"
            ],
            "additionalProperties": false
          },
          "pii": {
            "default": false,
            "type": "boolean"
          },
          "tags": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approval": {
            "type": "object",
            "properties": {
              "by": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "environments": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "note": {
                "type": "string"
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^sha256-[a-f0-9]{16}$"
              }
            },
            "required": [
              "by",
              "at",
              "fingerprint"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "title",
          "description",
          "effect",
          "status",
          "source",
          "input",
          "authorization",
          "tenancy",
          "execution"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "service",
    "identity",
    "capabilities"
  ],
  "additionalProperties": false
}
