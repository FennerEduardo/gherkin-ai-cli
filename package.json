{
  "name": "gherkin-ai",
  "version": "1.4.0",
  "description": "CLI tool & contract engine translating Gherkin specs into production-grade executable prompts, TypeScript contracts, and seed fixtures for AI Coding Agents.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gherkin-ai": "./bin/gherkin-ai.js",
    "ghk": "./bin/gherkin-ai.js",
    "gherkin-cli": "./bin/gherkin-ai.js",
    "gherkin-ia": "./bin/gherkin-ai.js"
  },
  "readmeFilename": "README.md",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "gherkin",
    "bdd",
    "ai-agent",
    "prompts",
    "architecture",
    "ddd",
    "cqrs",
    "clean-architecture",
    "hexagonal-architecture",
    "claude-code",
    "cursor",
    "antigravity",
    "ghk",
    "brownfield",
    "detect",
    "create",
    "wizard"
  ],
  "author": "Fenner Eduardo <contact@fennereduardo.com> (https://fennereduardo.com)",
  "license": "MIT",
  "homepage": "https://fennereduardo.com/pages/GherkinIATool/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FennerEduardo/gherkin-ai-cli.git"
  },
  "bugs": {
    "url": "https://github.com/FennerEduardo/gherkin-ai-cli/issues"
  },
  "scripts": {
    "build": "npx tsc",
    "start": "node ./bin/gherkin-ai.js",
    "dev": "npx tsc --watch",
    "test": "npx ts-node tests/parser.test.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "inquirer": "^8.2.6"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
