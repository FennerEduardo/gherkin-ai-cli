{
  "name": "gherkin-ai",
  "version": "3.0.0-beta.1",
  "description": "Spec-driven verification, governance and prompt generation for AI coding agents, with org-level policy, multi-provider LLM support and a least-privilege MCP server.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gherkin-ai": "bin/gherkin-ai.js",
    "ghk": "bin/gherkin-ai.js",
    "gherkin-cli": "bin/gherkin-ai.js",
    "gherkin-ia": "bin/gherkin-ai.js"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "schemas"
  ],
  "keywords": [
    "gherkin",
    "bdd",
    "ai-agent",
    "mcp",
    "model-context-protocol",
    "closed-loop",
    "auto-fix",
    "self-healing",
    "guardrails",
    "agentic-workflow",
    "prompts",
    "architecture",
    "ddd",
    "cqrs",
    "claude-code",
    "cursor",
    "antigravity",
    "windsurf",
    "ghk",
    "playwright",
    "cucumber",
    "spring-boot",
    "react",
    "graphql"
  ],
  "author": "Fenner Eduardo <contact@fennereduardo.com> (https://fennereduardo.com)",
  "license": "MIT",
  "homepage": "https://fennereduardo.com/pages/gherkin-ai-agent-architect",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FennerEduardo/gherkin-ai-cli.git"
  },
  "bugs": {
    "url": "https://github.com/FennerEduardo/gherkin-ai-cli/issues"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "build": "tsc && node scripts/build-ui.js && npm run schema",
    "schema": "node -e \"const {buildConfigJsonSchema}=require('./dist/core/config/json-schema');require('fs').mkdirSync('schemas',{recursive:true});require('fs').writeFileSync('schemas/config.schema.json', JSON.stringify(buildConfigJsonSchema(), null, 2) + '\\n')\"",
    "start": "node ./bin/gherkin-ai.js",
    "dev": "npx tsc --watch",
    "eval": "npx ts-node evals/runner.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepublishOnly": "npm run build",
    "publish:beta": "npm run build && npm publish --tag beta",
    "release": "commit-and-tag-version",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "publish:prod": "npm run build && npm publish"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.34.2",
    "@anthropic-ai/sdk": "^0.131.0",
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@google/genai": "^2.26.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "express": "^5.2.1",
    "inquirer": "^8.2.6",
    "openai": "^4.0.0",
    "ts-morph": "^28.0.0",
    "undici": "^6.29.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/inquirer": "^8.2.10",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.11",
    "commit-and-tag-version": "^12.5.0",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.0"
  }
}
