# Environment Variables for assessment-service
NODE_ENV=development
PORT=3000

# Database Connection
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/assessment-service_db?schema=public

# Security & Authentication
JWT_SECRET=<YOUR_SUPER_SECRET_JWT_KEY_MIN_32_CHARS>
JWT_TTL_SECONDS=900
BCRYPT_COST_FACTOR=12

# Serverless & Cloud Configuration
AWS_REGION=us-east-1
SERVERLESS_STAGE=dev
